{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/sign-in"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
