# dependencies
/node_modules

# Next.js
/.next/
/out/

# generated service worker
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# tests
/coverage/
/playwright-report/
/test-results/
/.lighthouseci/
# Lighthouse CLI writes <host>_<date>_<time>.report.html/.json to cwd
/*.report.html
/*.report.json

# environment
.env
.env.*
!.env.example

# local Supabase
/supabase/.branches
/supabase/.temp

# logs and OS
*.log
.DS_Store

# TypeScript
*.tsbuildinfo

# Claude Code local state
.claude/settings.local.json
/session-context.md
# Archived session contexts. Same hazard as the line above: Prettier walks
# untracked files too, so an unformatted note here would fail format:check —
# the first step of `npm run verify`. Prettier 3 reads .gitignore by default,
# so ignoring it here excludes it from both git and the format gate.
/.archive/
