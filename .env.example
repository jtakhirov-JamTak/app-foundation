# Public browser-safe configuration
NEXT_PUBLIC_APP_ID=replace-with-repository-name
NEXT_PUBLIC_APP_VERSION=dev
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Server-only deployment mode: local, test, or production.
# Production requires distributed rate limiting.
APP_ENV=local
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Required only when APP_ENV=production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
