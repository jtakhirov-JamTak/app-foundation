{
  "name": "app-foundation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "predev": "node scripts/validate-env.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/validate-env.mjs",
    "build": "next build --webpack",
    "prestart": "node scripts/validate-env.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=mobile-chromium",
    "test:e2e:webkit": "playwright test --project=mobile-webkit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/run-db-tests.mjs",
    "db:types": "node scripts/sync-database-types.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:sw": "node scripts/check-service-worker.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:analytics": "node scripts/check-analytics-contract.mjs",
    "verify:sw-version-bust": "node scripts/verify-sw-version-bust.mjs",
    "verify:example-removal": "node scripts/verify-example-removal.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle && npm run check:sw && npm run check:secrets && npm run check:analytics",
    "check:db-types": "node scripts/check-generated-types.mjs /tmp/database.ts"
  },
  "dependencies": {
    "@serwist/next": "9.5.11",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.37.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "swr": "2.4.2",
    "web-vitals": "5.3.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.0"
    }
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "24.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "prettier": "3.7.4",
    "serwist": "9.5.11",
    "supabase": "2.109.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
